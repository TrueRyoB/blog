---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ "/feed.xml" | prepend: site.baseurl | prepend: site.url }}" rel="self"/>
  <link href="{{ site.url }}{{ site.baseurl }}/"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ site.url }}{{ site.baseurl }}/</id>
  <author>
    <name>{{ site.author.name | xml_escape }}</name>
    {% if site.author.email %}
    <email>{{ site.author.email | xml_escape }}</email>
    {% endif %}
  </author>
  <rights>© {{ site.time | date: "%Y" }} {{ site.author.name | xml_escape }}</rights>
  {% for post in site.posts limit:20 %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | prepend: site.baseurl | prepend: site.url }}"/>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    <id>{{ post.url | prepend: site.baseurl | prepend: site.url }}</id>
    {% if post.description %}
    <summary>{{ post.description | xml_escape }}</summary>
    {% elsif post.excerpt %}
    <summary>{{ post.excerpt | strip_html | strip_newlines | truncate: 200 | xml_escape }}</summary>
    {% endif %}
    <content type="html">{{ post.content | xml_escape }}</content>
    {% for tag in post.tags %}
    <category term="{{ tag | xml_escape }}"/>
    {% endfor %}
  </entry>
  {% endfor %}
</feed>
